{
  "id": "com.cygnussia.ollama-bridge",
  "name": "CygnussIA - Ollama complement for Photoshop",
  "version": "0.0.1",
  "main": "index.html",
  "host": [{ "app": "PS", "minVersion": "24.0.0" }],
  "manifestVersion": 5,
  "entrypoints": [
    {
      "type": "panel",
      "id": "ollamaMainPanel",
      "label": "IA Local (Ollama)",
      "minimumSize": {"width": 320, "height": 550},
      "maximumSize": {"width": 600, "height": 1000}
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": ["http://127.0.0.1:8000", "http://localhost:8000"]
    },
    "clipboard": "readAndWrite"
  },
  "icons": [
    { "width": 24, "height": 24, "path": "icons/icon-24.png" },
    { "width": 32, "height": 32, "path": "icons/icon-32.png" },
    { "width": 48, "height": 48, "path": "icons/icon-48.png" }
  ]
}